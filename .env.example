# ---------------------------------------------------------------------------
# Local LLM served by Ollama — no cloud API key needed for inference.
# ---------------------------------------------------------------------------

# Where the Ollama daemon listens. Leave as-is for a local install.
OLLAMA_HOST=http://localhost:11434

# Model tag, as shown by `ollama list`. Must support tool calling.
# qwen3:8b fits the smallest card we target, a 12 GB RTX 4080 Laptop.
DEEP_AGENT_MODEL=qwen3:8b

# Context window in tokens. This is the single most important knob:
# Ollama defaults to a small window and SILENTLY TRUNCATES beyond it,
# which makes a deep agent forget its own plan mid-run.
# 24576 is safe on 12 GB. On 16 GB try 32768, on 24 GB+ try 40960.
DEEP_AGENT_NUM_CTX=24576

# Keep the weights resident in VRAM between calls. A deep agent makes many
# short calls; without this Ollama evicts the model and reloads it each time.
DEEP_AGENT_KEEP_ALIVE=30m

# Qwen3-style thinking blocks. "false" is recommended: visible reasoning
# burns context and confuses some tool-call parsers. Set "true" to inspect it.
DEEP_AGENT_REASONING=false

# ---------------------------------------------------------------------------
# Which backend to reach the model through.
#   ollama      (default) straight to the Ollama daemon — use this for the
#               agent labs, it is the only path that carries tool calls today.
#   ollabridge  through an OllaBridge gateway (OpenAI-compatible), which can
#               also front remote GPUs and your own provider keys.
#               Run `make ollabridge` to see what your version supports.
# ---------------------------------------------------------------------------
DEEP_AGENT_BACKEND=ollama

# `make ollabridge` needs nothing here. It sets the backend itself, and a
# gateway started with `--auth-mode local-trust` waves through anything coming
# from this machine, so there is no key to copy. Both lines below are overrides
# for the cases where the defaults are wrong: a gateway on another machine or a
# different port, or one started with `--auth-mode required`.
# (Note the port is 11435 — Ollama itself is on 11434.)
#OLLABRIDGE_URL=http://localhost:11435/v1
#OLLABRIDGE_API_KEY=sk-ollabridge-...

# ---------------------------------------------------------------------------
# Web search tool (still a hosted service — the free tier is enough).
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-...

# ---------------------------------------------------------------------------
# Optional: observability (see 03_observed_agent.py).
# Works with Langfuse Cloud or a self-hosted instance.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
